NODE_ENV=development
PORT=5000

# Use a database-specific user and require TLS for remote MongoDB connections.
MONGODB_URI=mongodb://127.0.0.1:27017/happy_bounty

TRUST_PROXY_HOPS=0
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_WALLETS=

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

DISTRIBUTION_SYNC_ENABLED=true
CLAIM_SYNC_ENABLED=true

API_RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_GENERAL=600
RATE_LIMIT_PRIVATE_READ_IP=300
RATE_LIMIT_PRIVATE_READ_WALLET=60
